# ================================================================
# GASTOS DE VIAJE (GBS) — Variables de Entorno de Ejemplo
# Copia este archivo como `.env.local` para desarrollo local:
# `cp .env.example .env.local`
# NOTA IMPORTANTE: NUNCA subas .env.local o claves secretas al repositorio.
# ================================================================

# ── Entorno de la Aplicación ────────────────────────────────────
# Opciones: development | staging | production
APP_ENVIRONMENT=development

# ── Supabase (Base de datos & Auth) ──────────────────────────────
# Obtener en: Supabase Dashboard → Tu Proyecto → Project Settings → API
# URL pública de Supabase (RESTRICCIÓN: Sin barra `/` al final)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co

# Llave pública de Supabase (Anon Key / Publishable Key para cliente browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Llave de rol de servicio Supabase (Service Role Key - SOLO SERVIDOR, secreto)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# ── Correos Transaccionales (Resend) ────────────────────────────
# Obtener en: https://resend.com → API Keys
# API Key de Resend (para enviar notificaciones por correo)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Correo remitente autorizado (debe estar verificado en Resend)
CORREO_REMITENTE=viaticos@gbsolutions.com

# ── URL Base de la Aplicación ────────────────────────────────────
# RESTRICCIÓN: No incluir barra `/` al final.
# En desarrollo: http://localhost:3000
# En producción: https://gastos-de-viaje-gbs.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Integración Clara (Opcional / Futura) ────────────────────────
CLARA_API_URL=https://api.clara.com/v1
CLARA_CLIENT_ID=
CLARA_CLIENT_SECRET=
CLARA_SYNC_ENABLED=false
