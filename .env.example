# ================================================================
# GASTOS DE VIAJE — Variables de entorno
# Copia este archivo como .env.local y llena los valores
# NUNCA subas .env.local a Git
# ================================================================

# ── Supabase ──────────────────────────────────────────────────
# Obtener en: https://app.supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Correos con Resend ────────────────────────────────────────
# Crear cuenta en: https://resend.com (gratis hasta 3,000/mes)
# Requiere verificar tu dominio de correo
RESEND_API_KEY=re_xxxxxxxxxxxx
CORREO_REMITENTE=viaticos@tudominio.com

# ── URL de la app ────────────────────────────────────────────
# En desarrollo:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción (cambiar al URL de Vercel o tu dominio):
# NEXT_PUBLIC_APP_URL=https://viaticos.tuempresa.com

# ── Login con Google (OAuth) ─────────────────────────────────
# Configurar en: Supabase → Authentication → Providers → Google
# Y en: https://console.cloud.google.com → APIs → Credentials
# (No se necesita aquí, se configura en el dashboard de Supabase)

# ── Login con Microsoft (Azure AD) ──────────────────────────
# Configurar en: Supabase → Authentication → Providers → Azure
# Y en: https://portal.azure.com → App registrations
# (No se necesita aquí, se configura en el dashboard de Supabase)

# ── Integración Clara (futura) ──────────────────────────────
# Solicitar credenciales a tu agente de cuenta Clara
CLARA_API_URL=https://api.clara.com/v1
CLARA_CLIENT_ID=
CLARA_CLIENT_SECRET=
CLARA_SYNC_ENABLED=false
